<?xml version="1.0"?>
<Container version="2">
  <Name>run-ptc</Name>
  <Repository>ghcr.io/cailloux/run-ptc:latest</Repository>
  <Registry>https://github.com/cailloux/run-ptc/pkgs/container/run-ptc</Registry>
  <Network>services</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/cailloux/run-ptc</Support>
  <Project>https://github.com/cailloux/run-ptc</Project>
  <Overview>Run PTC: cart path and road coverage for Peachtree City. Needs run-ptc-db on the services network. Applies migrations and exclusions on startup. Import city data with: docker exec run-ptc python -m app.cli import</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>run-ptc-db</Requires>
  <Config Name="WebUI Port" Target="8000" Default="8010" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">8010</Config>
  <Config Name="DATABASE_URL" Target="DATABASE_URL" Default="" Mode="" Description="postgresql://runptc:PASSWORD@run-ptc-db:5432/runptc" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="INTERVALS_ATHLETE_ID" Target="INTERVALS_ATHLETE_ID" Default="" Mode="" Description="Used from Phase 2." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="INTERVALS_API_KEY" Target="INTERVALS_API_KEY" Default="" Mode="" Description="Used from Phase 2. Read-only use." Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">America/New_York</Config>
</Container>
